<?xml version="1.0" encoding="utf-8"?>
<!-- Tie queue simulation template for SDK + XPL semi-control -->
<Xpl-source>
<HostEnvironment>
<Config>
<FileId>0x758d1814</FileId>
<Target>Robox Motion Control</Target>
<XplType>RoboticProgramLanguage</XplType>
</Config>
</HostEnvironment>
<XplEnvironment>
<Info>
<Title LcId="1033">
<![CDATA[TIE_QUEUE_SIM]]>
</Title>
<Description LcId="1033">
<![CDATA[Mixed PointJ/PointC queue runner. PC sets counts, profiles, motion types and targets before PC_BOOL[3].]]>
</Description>
<Version>1.0.0</Version>
<Author>Codex template based on Efort SDK DEMO_TRACK.XPL</Author>
</Info>
<Pous>
<Pou>
<Name>Main</Name>
<Type>Program</Type>
<VarDeclarations>
<VarLocal>
<Var>
<Name>i_0</Name>
<Type>DINT</Type>
<InitValue>0</InitValue>
</Var>
<Var>
<Name>i_1</Name>
<Type>DINT</Type>
</Var>
<Var>
<Name>curMoveCount</Name>
<Type>DINT</Type>
<InitValue>0</InitValue>
</Var>
</VarLocal>
</VarDeclarations>
<Body>
<set>
<dest>comutil.PC_BOOL[3]</dest>
<expr>false</expr>
</set>
<set>
<dest>comutil.PC_BOOL[1]</dest>
<expr>false</expr>
</set>
<set>
<dest>comutil.PC_BOOL[2]</dest>
<expr>false</expr>
</set>
<set>
<dest>comutil.PC_BOOL[0]</dest>
<expr>false</expr>
</set>
<set>
<dest>comutil.PC_INT[0]</dest>
<expr>0</expr>
</set>
<set>
<dest>comutil.PC_BOOL[5]</dest>
<expr>false</expr>
</set>
<set>
<dest>comutil.PC_INT[3]</dest>
<expr>0</expr>
</set>
<call>
<subroutine>
<name>track.init</name>
</subroutine>
</call>
<call>
<subroutine>
<name>track.dropAllObj</name>
</subroutine>
</call>
<call>
<subroutine>
<name>track.getWobj</name>
<args>
<arg>11</arg>
</args>
</subroutine>
</call>
<rem>
<text />
</rem>
<while>
<cond>true</cond>
<pouref>2</pouref>
</while>
<set>
<dest>i_1</dest>
<expr>comutil.PC_INT[0]</expr>
</set>
<rem>
<text>first part</text>
</rem>
<for>
<var>i_0</var>
<from>0</from>
<to>24</to>
<pouref>3</pouref>
</for>
<while>
<cond>true</cond>
<pouref>1</pouref>
</while>
<label>
<name>exitmove</name>
</label>
<rem>
<text>发送结束标志</text>
</rem>
<set>
<dest>comutil.PC_BOOL[0]</dest>
<expr>true</expr>
</set>
</Body>
<Pou>
<Name>2</Name>
<Body>
<if>
<case>
<cond>comutil.PC_BOOL[3]==true</cond>
<pouref>1</pouref>
</case>
</if>
</Body>
<Pou>
<Name>1</Name>
<Body>
<break />
</Body>
</Pou>
</Pou>
<Pou>
<Name>3</Name>
<Body>
<if>
<case>
<cond>comutil.PC_BOOL[4]==true</cond>
<pouref>2</pouref>
</case>
<case>
<cond>curMoveCount==i_1</cond>
<pouref>2</pouref>
</case>
</if>
<if>
<case>
<cond>comutil.PC_INT[10+i_0]==1&amp;&amp;comutil.PC_INT[1]==100</cond>
<pouref>10</pouref>
</case>
<case>
<cond>comutil.PC_INT[10+i_0]==0&amp;&amp;comutil.PC_INT[2]==100</cond>
<pouref>11</pouref>
</case>
<case>
<cond>comutil.PC_INT[10+i_0]==0&amp;&amp;comutil.PC_INT[2]==800</cond>
<pouref>12</pouref>
</case>
<case>
<cond>(comutil.PC_INT[10+i_0]==1&amp;&amp;comutil.PC_INT[1]!=100)||(comutil.PC_INT[10+i_0]==0&amp;&amp;comutil.PC_INT[2]!=100&amp;&amp;comutil.PC_INT[2]!=800)</cond>
<pouref>13</pouref>
</case>
<case>
<cond>comutil.PC_INT[10+i_0]!=0&amp;&amp;comutil.PC_INT[10+i_0]!=1</cond>
<pouref>14</pouref>
</case>
</if>
<rem>
<text />
</rem>
<rem>
<text>执行到前半部分buffer，通过修改特定变量的方式，通知上位机发送后半部分buffer</text>
</rem>
<set>
<dest>curMoveCount</dest>
<expr>curMoveCount+1</expr>
</set>
<if>
<case>
<cond>curMoveCount==i_1</cond>
<pouref>2</pouref>
</case>
</if>
<if>
<case>
<cond>i_0==24</cond>
<pouref>1</pouref>
</case>
</if>
</Body>
<Pou>
<Name>1</Name>
<Body>
<set>
<dest>comutil.PC_BOOL[1]</dest>
<expr>true</expr>
</set>
</Body>
</Pou>
<Pou>
<Name>2</Name>
<Body>
<goto>
<name>exitmove</name>
</goto>
</Body>
</Pou>
<Pou>
<Name>10</Name>
<Body>
<call><subroutine><name>comutil.GetPC_POINTJ</name><args><arg>i_0</arg></args></subroutine></call>
<mjoint>
<target>comutil.PC_POINTJ[i_0]</target>
<speed>v100perc</speed>
<zone>fine</zone>
<tool>tool1</tool>
</mjoint>
</Body>
</Pou>
<Pou>
<Name>11</Name>
<Body>
<call><subroutine><name>comutil.GetPC_POINTC</name><args><arg>i_0</arg></args></subroutine></call>
<mlin>
<target>comutil.PC_POINTC[i_0]</target>
<speed>v100</speed>
<zone>fine</zone>
<tool>tool1</tool>
<refsys>wobj_cvy</refsys>
</mlin>
</Body>
</Pou>
<Pou>
<Name>12</Name>
<Body>
<call><subroutine><name>comutil.GetPC_POINTC</name><args><arg>i_0</arg></args></subroutine></call>
<mlin>
<target>comutil.PC_POINTC[i_0]</target>
<speed>v800</speed>
<zone>fine</zone>
<tool>tool1</tool>
<refsys>wobj_cvy</refsys>
</mlin>
</Body>
</Pou>
<Pou>
<Name>13</Name>
<Body>
<set><dest>comutil.PC_INT[3]</dest><expr>9002</expr></set>
<set><dest>comutil.PC_BOOL[5]</dest><expr>true</expr></set>
<goto><name>exitmove</name></goto>
</Body>
</Pou>
<Pou>
<Name>14</Name>
<Body>
<set><dest>comutil.PC_INT[3]</dest><expr>9001</expr></set>
<set><dest>comutil.PC_BOOL[5]</dest><expr>true</expr></set>
<goto><name>exitmove</name></goto>
</Body>
</Pou>
</Pou>
<Pou>
<Name>1</Name>
<Body>
<rem>
<text>获取点位总数</text>
</rem>
<set>
<dest>i_1</dest>
<expr>comutil.PC_INT[0]</expr>
</set>
<while>
<cond>comutil.PC_BOOL[2]==true</cond>
<pouref>7</pouref>
</while>
<rem>
<text>接收并执行后半部分buffer</text>
</rem>
<for>
<var>i_0</var>
<from>25</from>
<to>49</to>
<pouref>3</pouref>
</for>
<while>
<cond>comutil.PC_BOOL[1]==true</cond>
<pouref>7</pouref>
</while>
<rem>
<text>循环接收并运行前半部分buffer</text>
</rem>
<for>
<var>i_0</var>
<from>0</from>
<to>24</to>
<by>1</by>
<pouref>6</pouref>
</for>
<rem>
<text />
</rem>
</Body>
<Pou>
<Name>3</Name>
<Body>
<if>
<case>
<cond>comutil.PC_BOOL[4]==true</cond>
<pouref>2</pouref>
</case>
<case>
<cond>curMoveCount==i_1</cond>
<pouref>2</pouref>
</case>
</if>
<if>
<case><cond>comutil.PC_INT[10+i_0]==1&amp;&amp;comutil.PC_INT[1]==100</cond><pouref>10</pouref></case>
<case><cond>comutil.PC_INT[10+i_0]==0&amp;&amp;comutil.PC_INT[2]==100</cond><pouref>11</pouref></case>
<case><cond>comutil.PC_INT[10+i_0]==0&amp;&amp;comutil.PC_INT[2]==800</cond><pouref>12</pouref></case>
<case><cond>(comutil.PC_INT[10+i_0]==1&amp;&amp;comutil.PC_INT[1]!=100)||(comutil.PC_INT[10+i_0]==0&amp;&amp;comutil.PC_INT[2]!=100&amp;&amp;comutil.PC_INT[2]!=800)</cond><pouref>13</pouref></case>
<case><cond>comutil.PC_INT[10+i_0]!=0&amp;&amp;comutil.PC_INT[10+i_0]!=1</cond><pouref>14</pouref></case>
</if>
<rem>
<text>执行到后半部分buffer，通过修改特定变量的方式，通知上位机发送前半部分buffer</text>
</rem>
<rem>
<text>如果点位达到设定值，退出</text>
</rem>
<set>
<dest>curMoveCount</dest>
<expr>curMoveCount+1</expr>
</set>
<if>
<case>
<cond>curMoveCount==i_1</cond>
<pouref>2</pouref>
</case>
</if>
<if>
<case>
<cond>i_0==49</cond>
<pouref>3</pouref>
</case>
</if>
</Body>
<Pou>
<Name>3</Name>
<Body>
<set>
<dest>comutil.PC_BOOL[2]</dest>
<expr>true</expr>
</set>
</Body>
</Pou>
<Pou>
<Name>2</Name>
<Body>
<goto>
<name>exitmove</name>
</goto>
</Body>
</Pou>
<Pou>
<Name>10</Name><Body>
<call><subroutine><name>comutil.GetPC_POINTJ</name><args><arg>i_0</arg></args></subroutine></call>
<mjoint><target>comutil.PC_POINTJ[i_0]</target><speed>v100perc</speed><zone>fine</zone><tool>tool1</tool></mjoint>
</Body></Pou>
<Pou>
<Name>11</Name><Body>
<call><subroutine><name>comutil.GetPC_POINTC</name><args><arg>i_0</arg></args></subroutine></call>
<mlin><target>comutil.PC_POINTC[i_0]</target><speed>v100</speed><zone>fine</zone><tool>tool1</tool><refsys>wobj_cvy</refsys></mlin>
</Body></Pou>
<Pou>
<Name>12</Name><Body>
<call><subroutine><name>comutil.GetPC_POINTC</name><args><arg>i_0</arg></args></subroutine></call>
<mlin><target>comutil.PC_POINTC[i_0]</target><speed>v800</speed><zone>fine</zone><tool>tool1</tool><refsys>wobj_cvy</refsys></mlin>
</Body></Pou>
<Pou><Name>13</Name><Body>
<set><dest>comutil.PC_INT[3]</dest><expr>9002</expr></set>
<set><dest>comutil.PC_BOOL[5]</dest><expr>true</expr></set>
<goto><name>exitmove</name></goto>
</Body></Pou>
<Pou><Name>14</Name><Body>
<set><dest>comutil.PC_INT[3]</dest><expr>9001</expr></set>
<set><dest>comutil.PC_BOOL[5]</dest><expr>true</expr></set>
<goto><name>exitmove</name></goto>
</Body></Pou>
</Pou>
<Pou>
<Name>6</Name>
<Body>
<if>
<case>
<cond>comutil.PC_BOOL[4]==true</cond>
<pouref>2</pouref>
</case>
<case>
<cond>curMoveCount==i_1</cond>
<pouref>2</pouref>
</case>
</if>
<if>
<case><cond>comutil.PC_INT[10+i_0]==1&amp;&amp;comutil.PC_INT[1]==100</cond><pouref>10</pouref></case>
<case><cond>comutil.PC_INT[10+i_0]==0&amp;&amp;comutil.PC_INT[2]==100</cond><pouref>11</pouref></case>
<case><cond>comutil.PC_INT[10+i_0]==0&amp;&amp;comutil.PC_INT[2]==800</cond><pouref>12</pouref></case>
<case><cond>(comutil.PC_INT[10+i_0]==1&amp;&amp;comutil.PC_INT[1]!=100)||(comutil.PC_INT[10+i_0]==0&amp;&amp;comutil.PC_INT[2]!=100&amp;&amp;comutil.PC_INT[2]!=800)</cond><pouref>13</pouref></case>
<case><cond>comutil.PC_INT[10+i_0]!=0&amp;&amp;comutil.PC_INT[10+i_0]!=1</cond><pouref>14</pouref></case>
</if>
<rem>
<text>执行到前半部分buffer，通过修改特定变量的方式，通知上位机发送后半部分buffer</text>
</rem>
<rem>
<text>如果点位达到设定值，退出</text>
</rem>
<set>
<dest>curMoveCount</dest>
<expr>curMoveCount+1</expr>
</set>
<if>
<case>
<cond>curMoveCount==i_1</cond>
<pouref>2</pouref>
</case>
</if>
<if>
<case>
<cond>i_0==24</cond>
<pouref>1</pouref>
</case>
</if>
</Body>
<Pou>
<Name>1</Name>
<Body>
<set>
<dest>comutil.PC_BOOL[1]</dest>
<expr>true</expr>
</set>
</Body>
</Pou>
<Pou>
<Name>2</Name>
<Body>
<goto>
<name>exitmove</name>
</goto>
</Body>
</Pou>
<Pou>
<Name>10</Name><Body>
<call><subroutine><name>comutil.GetPC_POINTJ</name><args><arg>i_0</arg></args></subroutine></call>
<mjoint><target>comutil.PC_POINTJ[i_0]</target><speed>v100perc</speed><zone>fine</zone><tool>tool1</tool></mjoint>
</Body></Pou>
<Pou>
<Name>11</Name><Body>
<call><subroutine><name>comutil.GetPC_POINTC</name><args><arg>i_0</arg></args></subroutine></call>
<mlin><target>comutil.PC_POINTC[i_0]</target><speed>v100</speed><zone>fine</zone><tool>tool1</tool><refsys>wobj_cvy</refsys></mlin>
</Body></Pou>
<Pou>
<Name>12</Name><Body>
<call><subroutine><name>comutil.GetPC_POINTC</name><args><arg>i_0</arg></args></subroutine></call>
<mlin><target>comutil.PC_POINTC[i_0]</target><speed>v800</speed><zone>fine</zone><tool>tool1</tool><refsys>wobj_cvy</refsys></mlin>
</Body></Pou>
<Pou><Name>13</Name><Body>
<set><dest>comutil.PC_INT[3]</dest><expr>9002</expr></set>
<set><dest>comutil.PC_BOOL[5]</dest><expr>true</expr></set>
<goto><name>exitmove</name></goto>
