<set><dest>comutil.PC_BOOL[5]</dest><expr>true</expr></set>
<goto><name>exitmove</name></goto>
</Body></Pou>
</Pou>
<Pou>
<Name>7</Name>
<Body>
<if>
<case>
<cond>comutil.PC_BOOL[4]==true</cond>
<pouref>1</pouref>
</case>
</if>
</Body>
<Pou>
<Name>1</Name>
<Body>
<goto>
<name>exitmove</name>
</goto>
</Body>
</Pou>
</Pou>
